// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Entity {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'PF' | 'PJ'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections     Connection[]
  accounts        Account[]
  transactions    Transaction[]
  creditCards     CreditCard[]
  creditCardBills CreditCardBill[]
  investments     Investment[]
}

model Connection {
  id              String   @id @default(uuid())
  externalItemId  String   @unique
  entityId        String?
  institutionName String?
  status          String
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity      Entity?      @relation(fields: [entityId], references: [id])
  accounts    Account[]
  investments Investment[]
}

model Account {
  id               String   @id @default(uuid())
  externalId       String   @unique
  connectionId     String
  entityId         String?
  institutionName  String?
  name             String
  type             String
  subtype          String?
  balance          Float
  availableBalance Float?
  currency         String   @default("BRL")
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connection   Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entity        Entity?         @relation(fields: [entityId], references: [id])
  transactions  Transaction[]
  creditCards   CreditCard[]
  expenses      Expense[]
  expenseSeries ExpenseSeries[]

  @@index([connectionId])
}

model Transaction {
  id                  String   @id @default(uuid())
  externalId          String?  @unique // ID do Pluggy
  accountId           String?
  creditCardId        String?
  entityId            String?
  date                DateTime
  liquidationDate     DateTime?
  originalDescription String
  normalizedDescription String?
  amount              Float
  type                String   // 'PIX_IN', 'PIX_OUT', 'TED', 'DOC', 'CREDIT_CARD', 'REFUND', 'IOF', 'INTEREST', 'FEE', 'INVESTMENT', 'REDEMPTION', 'TRANSFER', 'CASHBACK', 'BOLETO', 'DEPOSIT', 'WITHDRAWAL'
  balance             Float?
  currency            String   @default("BRL")
  
  // Categorização (Compartilhada)
  categoryId          String?
  subcategoryId       String?
  tags                String?
  
  isReconciled        Boolean  @default(false)
  origin              String   @default("OPEN_FINANCE") // 'OPEN_FINANCE', 'MANUAL', 'CSV'
  notes               String?
  status              String?

  // Pluggy fields para não quebrar a importação inicial
  category            String?
  originalCategory    String?
  classification      String?
  billForecastDate    String?
  purchaseDate        DateTime?
  totalInstallments   Int?
  installmentNumber   Int?
  cardNumber          String?
  pluggyUpdatedAt     DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account             Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creditCard          CreditCard? @relation(fields: [creditCardId], references: [id])
  entity              Entity?     @relation(fields: [entityId], references: [id])
  
  categoryRelation    Category?   @relation("TransactionCategory", fields: [categoryId], references: [id])
  subcategoryRelation Category?   @relation("TransactionSubcategory", fields: [subcategoryId], references: [id])
  
  reconciliations     Reconciliation[]

  @@index([accountId])
  @@index([date])
}

model CreditCard {
  id              String   @id @default(uuid())
  externalId      String   @unique
  accountId       String
  entityId        String?
  institutionName String?
  name            String
  lastFourDigits  String?
  creditLimit     Float?
  availableLimit  Float?
  closingDay      Int?
  dueDay          Int?
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entity        Entity?          @relation(fields: [entityId], references: [id])
  bills         CreditCardBill[]
  transactions  Transaction[]
  expenses      Expense[]
  expenseSeries ExpenseSeries[]
}

model CreditCardBill {
  id             String   @id @default(uuid())
  externalId     String   @unique
  creditCardId   String
  entityId       String?
  referenceMonth String?
  closingDate    DateTime?
  dueDate        DateTime?
  totalAmount    Float
  minimumAmount  Float?
  paidAmount     Float?
  financeCharges Float?
  status         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  entity     Entity?    @relation(fields: [entityId], references: [id])

  @@index([creditCardId])
}

model Investment {
  id              String   @id @default(uuid())
  externalId      String   @unique
  connectionId    String
  entityId        String?
  institutionName String?
  name            String
  code            String?
  type            String?
  subtype         String?
  investedAmount  Float?
  currentAmount   Float
  quantity        Float?
  unitPrice       Float?
  maturityDate    DateTime?
  liquidityDate   DateTime?
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entity     Entity?    @relation(fields: [entityId], references: [id])
}

model SyncLog {
  id            String   @id @default(uuid())
  resource      String
  startedAt     DateTime
  finishedAt    DateTime?
  status        String   // 'SUCCESS' | 'ERROR' | 'RUNNING'
  importedCount Int      @default(0)
  updatedCount  Int      @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'FIXED', 'VARIABLE', 'ESSENTIAL', 'NON_ESSENTIAL'
  color     String?
  parentId  String?
  showOnHome Boolean @default(true)
  ignoreInTotals Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children  Category[] @relation("Subcategories")

  rules     TransactionRule[]
  overrides TransactionOverride[]
  
  transactions    Transaction[] @relation("TransactionCategory")
  subtransactions Transaction[] @relation("TransactionSubcategory")
  
  expenses        Expense[]     @relation("ExpenseCategory")
  subexpenses     Expense[]     @relation("ExpenseSubcategory")
  
  series          ExpenseSeries[] @relation("SeriesCategory")
  subseries       ExpenseSeries[] @relation("SeriesSubcategory")
}

model TransactionRule {
  id         String   @id @default(uuid())
  categoryId String
  pattern    String
  createdAt  DateTime @default(now())

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model TransactionOverride {
  externalId String   @id // Pluggy transaction ID
  categoryId String
  createdAt  DateTime @default(now())
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ExpenseSeries {
  id              String   @id @default(uuid())
  type            String   // 'RECURRING', 'INSTALLMENT'
  title           String
  description     String?
  baseAmount      Float?   
  totalAmount     Float?   // Para parcelamentos
  installments    Int?
  frequency       String?  // 'MONTHLY', 'WEEKLY', 'YEARLY', 'CUSTOM'
  startDate       DateTime
  endDate         DateTime?
  
  // Configuração Padrão da Série
  categoryId      String?
  subcategoryId   String?
  tags            String?
  supplier        String?
  costCenter      String?
  project         String?
  
  paymentMethod   String?
  accountId       String?
  creditCardId    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  account         Account?    @relation(fields: [accountId], references: [id])
  creditCard      CreditCard? @relation(fields: [creditCardId], references: [id])
  
  category        Category?   @relation("SeriesCategory", fields: [categoryId], references: [id])
  subcategory     Category?   @relation("SeriesSubcategory", fields: [subcategoryId], references: [id])
  
  expenses        Expense[]
}

model Expense {
  id              String   @id @default(uuid())
  seriesId        String?  // Nulo se for despesa ÚNICA
  
  title           String
  description     String?
  amount          Float
  
  dueDate         DateTime
  competenceDate  DateTime?
  
  installmentNum  Int?     // Ex: 1 (de 12)
  
  // Categorização
  categoryId      String?
  subcategoryId   String?
  tags            String?
  supplier        String?
  costCenter      String?
  project         String?
  
  // Pagamento
  paymentMethod   String?
  accountId       String?
  creditCardId    String?
  
  notes           String?
  attachments     String?  // JSON ou URL
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  account         Account?    @relation(fields: [accountId], references: [id])
  creditCard      CreditCard? @relation(fields: [creditCardId], references: [id])
  
  series          ExpenseSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  category        Category?      @relation("ExpenseCategory", fields: [categoryId], references: [id])
  subcategory     Category?      @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id])
  
  reconciliations Reconciliation[]
}

model Reconciliation {
  id              String   @id @default(uuid())
  transactionId   String
  expenseId       String
  amount          Float    // Quanto dessa transação pagou essa despesa
  createdAt       DateTime @default(now())
  
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  expense         Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  
  @@unique([transactionId, expenseId])
}
